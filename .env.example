DISCORD_TOKEN=
ANTHROPIC_API_KEY=
# Haiku is plenty for extraction and ~10x cheaper than Sonnet; swap if summaries feel thin.
ANTHROPIC_MODEL=claude-haiku-5-5
SPREADSHEET_ID=
# Either a file path...
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
# ...or the raw JSON contents (use this on Railway/Render; takes priority over the file)
GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT=
# Optional: restrict the bot to one channel (leave empty for any channel)
ALLOWED_CHANNEL_ID=
TIMEZONE=Asia/Makassar
COMMAND_PREFIX=!aclinic

# Notion (optional; enables !aclinic task)
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Property names in your Notion database (only used if they exist with a matching type)
NOTION_PRIORITY_PROP=Priority
NOTION_DUE_PROP=Due
NOTION_STATUS_PROP=Status
